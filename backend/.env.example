# ---------------------------------------------------------------------------
#  JobRadar API — configuration
# ---------------------------------------------------------------------------
NODE_ENV=development
PORT=3000

# PostgreSQL (adapté au script `npm run db:start` qui lance un cluster local)
DATABASE_URL="postgresql://jobradar:jobradar@localhost:55432/jobradar"

# Secret JWT (>= 16 caractères, générez-en un : openssl rand -base64 32)
JWT_SECRET="change-me-with-a-long-random-secret"
JWT_EXPIRES_IN=7d

# Origines autorisées (séparées par des virgules)
CORS_ORIGIN=http://localhost:4200

# --- Fournisseurs d'offres -------------------------------------------------
# France Travail : https://francetravail.io (laisser vide pour désactiver)
FRANCE_TRAVAIL_CLIENT_ID=
FRANCE_TRAVAIL_CLIENT_SECRET=

# Remotive : API publique, activée par défaut
REMOTIVE_ENABLED=true
REMOTIVE_API_URL=https://remotive.com/api/remote-jobs
